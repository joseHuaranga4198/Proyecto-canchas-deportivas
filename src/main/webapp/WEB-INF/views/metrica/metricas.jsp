<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Métricas | CanchaYa</title><link rel="stylesheet" href="<c:url value='/css/comun.css'/>"><link rel="stylesheet" href="<c:url value='/css/navegacion.css'/>"><link rel="stylesheet" href="<c:url value='/css/sistema.css'/>">  <link rel="stylesheet" href="<c:url value='/css/botones.css'/>">
</head><body>
<%@ include file="/WEB-INF/views/comun/cabecera.jspf" %>
<main class="container"><p class="eyebrow">ANÁLISIS DEL SERVICIO</p><h1>Métricas del negocio</h1><p class="muted">Cinco métricas de estado puntual (valor actual) y cinco series de tiempo (valor de cada día, sin acumulados). Cada métrica explica la fecha y los estados que utiliza.</p>
<form class="filters" action="<c:url value='/admin/metricas'/>" method="get"><div class="field"><label for="desde">Desde</label><input id="desde" name="desde" type="date" value="${desde}" required></div><div class="field"><label for="hasta">Hasta</label><input id="hasta" name="hasta" type="date" value="${hasta}" required></div><div class="field"><label for="canchaId">Cancha</label><select id="canchaId" name="canchaId"><option value="">Todas</option><c:forEach var="c" items="${canchas}"><option value="${c.idCancha}" ${canchaId eq c.idCancha ? 'selected' : ''}><c:out value="${c.nombre}"/></option></c:forEach></select></div><button class="button primary">Actualizar métricas</button></form>
<c:url var="datosUrl" value="/admin/metricas/datos"><c:param name="desde" value="${desde}"/><c:param name="hasta" value="${hasta}"/><c:if test="${not empty canchaId}"><c:param name="canchaId" value="${canchaId}"/></c:if></c:url>
<p id="metricas-estado" role="status">Cargando métricas…</p><h2 class="metricas-titulo">Estado puntual</h2><div id="indicadores" class="indicadores-grid"></div><h2 class="metricas-titulo">Series de tiempo</h2><div id="graficos" class="metricas-grid" data-endpoint="<c:out value='${datosUrl}'/>"></div><noscript>Activa JavaScript para visualizar los gráficos de Chart.js.</noscript>
</main><footer>CanchaYa · Gráficos de datos reales de H2</footer><script src="<c:url value='/js/vendor/chart.umd.min.js'/>"></script><script src="<c:url value='/js/metricas.js'/>"></script></body></html>
